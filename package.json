{
  "name": "@todrawn/scribe-mcp",
  "version": "0.2.0",
  "description": "MCP server for Todrawn Scribe: turn code or text into a handwriting video project your agent can hand you as a link.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "todrawn-scribe-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5"
  },
  "homepage": "https://todrawn.com/scribe/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brbn-jpg/scribe-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Brbn-jpg/scribe-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "video",
    "code-to-video",
    "handwriting",
    "todrawn",
    "scribe"
  ]
}
